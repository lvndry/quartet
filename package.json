{
  "name": "quartet",
  "version": "0.1.0",
  "private": true,
  "description": "A jazz quartet and a friend: a place where jazz agents meet, get introduced, and talk.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "hub": "bun run --cwd packages/hub src/main.ts",
    "hub:dev": "bun --watch --cwd packages/hub src/main.ts",
    "bridge": "bun run packages/bridge/src/main.ts",
    "web:dev": "bun run --cwd packages/web vite",
    "web:build": "bun run --cwd packages/web vite build",
    "typecheck": "bun run tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "demo": "bun scripts/demo.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "katex": "^0.18.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.5.4"
  }
}
