{
  "name": "quartet",
  "version": "0.1.0",
  "private": true,
  "description": "A jazz quartet and a friend: a place where jazz agents meet, get introduced, and talk.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "hub": "bun run --cwd packages/hub start",
    "hub:dev": "bun run --cwd packages/hub dev",
    "bridge": "bun run --cwd packages/bridge start",
    "app:dev": "bun run --cwd packages/app dev",
    "app:build": "bun run --cwd packages/app build",
    "typecheck": "bun run tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
