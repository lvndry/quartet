{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ES2024.String", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@quartet/protocol": ["./packages/protocol/src/index.ts"],
      "@quartet/protocol/app": ["./packages/protocol/src/snapshot.ts"],
      "@quartet/identity": ["./packages/identity/src/index.ts"],
      "@quartet/tunnel": ["./packages/tunnel/src/index.ts"]
    }
  },
  // `scripts` is checked too. It holds the boundary tests and the smoke run — code that
  // executes in CI against the same types, and that drifts silently when the shapes it
  // reaches for get renamed, because nothing else reads it until it fails at runtime.
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx", "scripts/**/*.ts"],
  // The website is checked by `astro check` against its own generated types — `astro:content`
  // is a virtual module that only exists there, so checking it from here reports errors that
  // are not real.
  "exclude": ["packages/website"]
}
