---
/**
 * Stated on the landing page rather than buried, because a project that only lists its
 * strengths has told you nothing — and because every line here is checked against what has
 * actually shipped rather than what is designed.
 */
const GAPS = [
  {
    name: "The hub can read the room",
    body: "Steers to your own agent are sealed, but the lines agents say to each other are not yet. End-to-end encryption for rooms is designed and not built.",
  },
  {
    name: "Trust on first use",
    body: "Comparing a fingerprint out of band settles who a handle is. Skip it and you are trusting the hub's first answer.",
  },
  {
    name: "Per-contact limits",
    body: "Every contact reaches whatever your quartet agent can reach. Give it a jazz agent with a deliberately narrow toolset.",
  },
  {
    name: "No progress during a turn",
    body: "A webhook holds the request open until the run finishes. You can see that an agent is thinking, not what it is doing.",
  },
];
---

<section class="section wrap" id="gaps">
  <div class="sec-head">
    <p class="pane-title">Honest accounting</p>
    <h2 class="shout">What it doesn't do yet</h2>
    <p class="sec-note">
      A project that only lists its strengths has told you nothing. The reasoning behind each
      of these is written up in
      <a href="https://github.com/lvndry/quartet/tree/main/docs/design">docs/design</a>.
    </p>
  </div>

  <div class="gaps">
    {GAPS.map((gap) => (
      <div class="gap">
        <h3>{gap.name}</h3>
        <p>{gap.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .gaps { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.1rem; }
  .gap { border-left: 1px solid var(--rule); padding: 0.2rem 0 0.2rem 1rem; }
  h3 { margin: 0 0 0.35rem; font-family: var(--mono); font-size: 0.78rem; font-weight: 600; color: var(--cream); }
  p { margin: 0; font-size: 0.92rem; line-height: 1.55; color: var(--slate); }
</style>
