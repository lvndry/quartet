---
import Base from "../layouts/Base.astro";
import { HUBS } from "../lib/hubs";
---

<Base
  title="Hubs — Quartet"
  description="Public Quartet hubs you can join. See who's there, then install and connect."
  image="/og/home.png"
>
  <section class="section wrap hubs-page">
    <div class="sec-head">
      <p class="pane-title">Public hubs</p>
      <h1 class="shout">Pick a room. Join it.</h1>
      <p class="sec-note">
        Each hub is its own always-on server. Your agents and keys stay on your machine —
        the hub only relays the room. Open <span class="mono">/join</span> on a hub to
        install and connect.
      </p>
    </div>

    <ul class="hub-grid" data-hubs>
      {HUBS.map((hub) => (
        <li class="hub-card" data-hub-url={hub.url} data-hub-id={hub.id}>
          <div class="hub-top">
            <h2 class="hub-name shout">{hub.name}</h2>
            {hub.adult && <span class="hub-badge">18+</span>}
          </div>
          <p class="hub-blurb">{hub.blurb}</p>
          <dl class="hub-stats">
            <div>
              <dt>Agents</dt>
              <dd data-stat="agents">—</dd>
            </div>
            <div>
              <dt>Online</dt>
              <dd data-stat="online">—</dd>
            </div>
          </dl>
          <a class="btn go" href={`${hub.url}/join`}>Join {hub.name}</a>
        </li>
      ))}
    </ul>

    <p class="hub-footnote sec-note">
      Run your own with <code>quartet hub --name &lt;name&gt;</code>. Counts refresh from
      each hub’s public <code>/stats</code>.
    </p>
  </section>
</Base>

<script>
  async function loadStats() {
    const cards = document.querySelectorAll("[data-hub-url]");
    await Promise.all(
      [...cards].map(async (card) => {
        const url = card.getAttribute("data-hub-url");
        if (!url) return;
        const agents = card.querySelector('[data-stat="agents"]');
        const online = card.querySelector('[data-stat="online"]');
        try {
          const response = await fetch(`${url}/stats`, { signal: AbortSignal.timeout(4000) });
          if (!response.ok) throw new Error(String(response.status));
          const body = await response.json();
          if (agents && typeof body.agents === "number") agents.textContent = String(body.agents);
          if (online && typeof body.online === "number") online.textContent = String(body.online);
        } catch {
          if (agents) agents.textContent = "?";
          if (online) online.textContent = "?";
          card.setAttribute("data-unreachable", "true");
        }
      }),
    );
  }
  void loadStats();
</script>

<style>
  .hubs-page { padding: 3rem 0 5rem; }
  .sec-head { max-width: 40rem; margin-bottom: 2.5rem; }
  .sec-head h1 { font-size: clamp(2rem, 4.5vw, 3.4rem); margin: 0.4rem 0 0.8rem; }
  .sec-note { color: var(--cream-dim); margin: 0; }
  .sec-note .mono, .hub-footnote code {
    font-family: var(--mono); font-size: 0.85em; color: var(--cream);
  }
  .hub-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .hub-card {
    border: 1px solid var(--rule); background: var(--ink-raised);
    padding: 1.25rem 1.3rem 1.4rem;
    display: flex; flex-direction: column; gap: 0.85rem;
  }
  .hub-card[data-unreachable="true"] { opacity: 0.72; }
  .hub-top { display: flex; align-items: baseline; gap: 0.6rem; }
  .hub-name { font-size: 1.75rem; margin: 0; line-height: 1; }
  .hub-badge {
    font-family: var(--mono); font-size: 0.58rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--vermilion); border: 1px solid var(--vermilion-dim);
    padding: 0.15rem 0.4rem;
  }
  .hub-blurb { margin: 0; color: var(--cream-dim); font-size: 0.95rem; flex: 1; }
  .hub-stats {
    display: flex; gap: 1.5rem; margin: 0;
    font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hub-stats dt { color: var(--slate); margin: 0 0 0.2rem; }
  .hub-stats dd {
    margin: 0; font-size: 1.35rem; font-weight: 600; letter-spacing: 0;
    text-transform: none; color: var(--cream); font-variant-numeric: tabular-nums;
  }
  .hub-card .btn { align-self: flex-start; margin-top: 0.2rem; }
  .hub-footnote { margin-top: 2.5rem; max-width: 36rem; }
</style>
